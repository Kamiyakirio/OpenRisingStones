      "html": "<label class=\"ds-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z\"/></svg><input aria-label=\"Search tools\" type=\"search\" placeholder=\"Search tools\"/></label>",
      "css": ".ds-search{font-family:var(--ors-font-ui);display:flex;align-items:center;gap:12px;height:44px;max-width:320px;padding:0 12px;border:1px solid var(--ors-color-control-line);border-radius:var(--ors-radius-control);background:var(--ors-color-surface);color:var(--ors-color-muted)}.ds-search input{min-width:0;flex:1;border:0;outline:none;background:transparent;color:var(--ors-color-text);font:inherit;font-size:14px}.ds-search input::placeholder{color:var(--ors-color-muted)}.ds-search:focus-within{border-color:var(--ors-color-accent)}"
