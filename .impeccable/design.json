      "html": "<button class=\"ds-tool-row\"><span class=\"ds-tool-symbol\"><svg width=\"24\" height=\"24\" viewBox=\"0 0 256 256\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M168,76a12,12,0,1,1-12-12A12,12,0,0,1,168,76Zm42,79.08c-15.08,20.84-37.53,34.88-66.7,41.74-20.08,4.72-43.54,6-70.12,3.93q2.4,17.82,6.72,37.54a8,8,0,0,1-6.1,9.52,7.81,7.81,0,0,1-1.72.19,8,8,0,0,1-7.81-6.29q-4.89-22.36-7.41-42.62-20.22-2.51-42.58-7.41a8,8,0,0,1,3.43-15.63q19.7,4.32,37.5,6.73c-2.09-26.56-.78-50,3.93-70.06C66,83.55,80.05,61.1,100.88,46,115,35.76,140.15,23.64,179.27,24c21.19.21,40.83,4.33,43.81,6.08a8,8,0,0,1,2.83,2.83c1.75,3,5.87,22.59,6.08,43.78C232.21,98.31,228.57,129.44,210,155.08Zm-23.76,2.8A112.07,112.07,0,0,1,98.12,69.74C75.64,94,66.7,132.47,71.36,184.6,123.51,189.28,162,180.35,186.25,157.88ZM212.44,43.56a175.75,175.75,0,0,0-39.22-3.51c-24.34.64-44.71,6.49-60.76,17.39a96,96,0,0,0,86.09,86.1c10.91-16,16.76-36.42,17.4-60.76A175.82,175.82,0,0,0,212.44,43.56Z\"/></svg></span><span class=\"ds-tool-copy\"><strong>Fishing database</strong><span>Fish, conditions, and catch progress</span></span></button>",
      "css": ".ds-tool-row{font-family:var(--ors-font-ui);display:flex;align-items:center;gap:12px;width:100%;min-height:64px;padding:12px 16px;text-align:left;border:0;border-bottom:1px solid var(--ors-color-line);background:var(--ors-color-surface);color:var(--ors-color-text);transition:background-color 120ms,color 120ms,border-color 120ms;}.ds-tool-row:hover{background:var(--ors-color-hover)}.ds-tool-row:focus-visible{outline:2px solid var(--ors-color-accent);outline-offset:3px;outline-offset:-3px}.ds-tool-symbol{display:grid;place-items:center;width:36px;height:36px;flex-shrink:0;border:1px solid color-mix(in srgb,var(--ors-color-info) 18%,var(--ors-color-line));border-radius:var(--ors-radius-control);color:var(--ors-color-info);background:color-mix(in srgb,var(--ors-color-info) 4%,var(--ors-color-surface))}.ds-tool-copy{display:flex;flex-direction:column;gap:4px}.ds-tool-copy strong{font-size:16px;font-weight:600;line-height:24px}.ds-tool-copy>span{font-size:14px;line-height:20px;color:var(--ors-color-muted)}"
    }
  ],
  "narrative": {
    "northStar": "A familiar multi-tool application",
    "overview": "OpenRisingStones uses a familiar application layout for choosing and operating FF14 tools. Discord informs navigation and density: grouped destinations, persistent workspace context, compact controls, and direct task content. The identity comes from neutral surfaces, clear outlines, and a consistent relationship between each tool and its accent.\n\nLight mode pairs a milk-white canvas with white panels; dark mode pairs a matte-black canvas with neutral dark panels. Both share the same hierarchy and geometry. Actual game imagery belongs to its content; interface decoration does not introduce gradients, glow, or a simulated physical material.",
    "keyCharacteristics": [
      "Grouped application navigation and persistent workspace context.",
      "Compact sans typography with readable task density.",
      "Milk-white and matte-black grounds with contrasting full outlines.",
      "Muted tool accents, restrained motion, and explicit action states."
    ],
    "rules": [
      {
        "name": "The Tool Identity Rule",
        "body": "A tool keeps its muted accent in the selected navigation icon, its home symbol, workspace icon, and primary actions; color does not replace labels or action meaning.",
        "section": "colors"
      },
      {
        "name": "The Full Outline Rule",
        "body": "Use the surface-line token for panels and dividers, the control-line token for fields and outlined controls, and a control-line outline with a quiet selected fill for selected navigation.",
        "section": "colors"
      },
      {
        "name": "The Application Type Rule",
        "body": "Headings and controls use the same UI sans family. Establish hierarchy with size and weight rather than an added display face.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Routine workspaces and home panels use borders and tonal separation. Reserve soft depth for temporary overlays; do not add decorative glow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the shared theme tokens for new surfaces and controls.",
      "Do preserve visible full borders and keyboard focus.",
      "Do keep tool accents consistent with the existing feature mapping.",
      "Do distinguish real connection states, demonstrations, errors, and disabled actions in visible text.",
      "Do express both domain geometry and shared visual primitives through direct JSX/TSX utilities.",
      "Do preserve semantic game channel colors, chart category distinctions, and readable QR grounds."
    ],
    "donts": [
      "Don't introduce gradients, glow, or decorative physical textures into the application chrome.",
      "Don't use accent color as the only indicator of selection, status, or consent.",
      "Don't add a separate display font or inflate ordinary tool screens into promotional layouts.",
      "Don't issue requests from the development phone demonstration or present synthetic messages as a paired session.",
      "Don't use a Tailwind prefix or @apply; the project uses standard Tailwind v4 utilities and Preflight."
    ]
  }
}
