      "html": "<nav class=\"ds-nav\" aria-label=\"Tools\"><a href=\"#fishing\" aria-current=\"page\">Fishing</a><a href=\"#mentor\">Mentor records</a></nav>",
      "css": ".ds-nav{font-family:var(--ors-font-ui);display:grid;gap:4px}.ds-nav a{display:flex;align-items:center;min-height:44px;padding:8px 12px;border:1px solid transparent;border-radius:var(--ors-radius-control);font-size:14px;font-weight:500;line-height:20px;color:var(--ors-color-muted);text-decoration:none;transition:background-color 120ms,color 120ms,border-color 120ms;}.ds-nav a:hover{background:var(--ors-color-hover);color:var(--ors-color-text)}.ds-nav a[aria-current=page]{background:var(--ors-color-selected);border-color:var(--ors-color-control-line);font-weight:600;color:var(--ors-color-text)}.ds-nav a:focus-visible{outline:2px solid var(--ors-color-accent);outline-offset:3px;}"
