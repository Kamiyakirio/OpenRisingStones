{
  "name": "open-rising-stones",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fishing:data:update": "node scripts/update-fishing-data.mjs",
    "gearing:data:update": "node scripts/update-gearing-data.mjs",
    "predev": "node scripts/check-gearing-data.mjs && node scripts/check-fishing-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-gearing-data.mjs && node scripts/check-fishing-data.mjs",
    "build": "tsc -b && vite build && vite build --config vite.mobile.config.ts",
    "lint": "eslint .",
    "pretest": "node scripts/check-gearing-data.mjs && node scripts/check-fishing-data.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "skills:install": "node scripts/install-skills.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.12.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tauri-apps/cli": "^2.12.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "papaparse": "^5.7.0",
    "pinyin-pro": "^3.29.4",
    "prettier": "^3.9.9",
    "skills": "1.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
